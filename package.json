{
  "name": "codex-remote",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "package:web": "npm run build && python scripts/package_web.py",
    "test:ui": "npm run build && node --test tests/workbench.test.ts"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.4",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  }
}
