{
  "name": "codex-remote",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/workbench/offline/tsconfig.worker.json",
    "package:web": "npm run build && python scripts/package_web.py",
    "test:ui": "npm run build && node --test tests/antigravity.test.mjs tests/attachment-upload.test.mjs tests/desktop-baseline.test.ts tests/workbench.test.ts tests/resume.test.ts tests/web-preview.test.mjs"
  },
  "dependencies": {
    "core-js": "3.41.0",
    "katex": "0.19.1",
    "marked": "18.3.0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  }
}
